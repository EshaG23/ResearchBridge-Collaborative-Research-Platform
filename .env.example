# Reference only: set these in your host environment. Django does not auto-load this file.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=your-exact-host.example
RESEARCHBRIDGE_DATA_DIR=/absolute/persistent/researchbridge-data
RESEARCHBRIDGE_AUTH_MODE=real
RESEARCHBRIDGE_PASSWORD_RESET_ENABLED=0
# Keep 0 when skipping email. Set 1 only after configuring and testing SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-project-sender@example.com
SMTP_PASSWORD=SET_PRIVATELY_IN_HOST_CONFIGURATION
ACHIEVEMENT_DAYS=365
